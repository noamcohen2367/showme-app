{
  "expo": {
    "name": "ShowMI",
    "slug": "showmi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3D2B8F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.showmi.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3D2B8F"
      },
      "package": "com.showmi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supportsRTL": true
    },
    "plugins": ["expo-localization"]
  }
}
